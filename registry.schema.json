{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/normlanguage/registry/main/registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "packages"],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "owner", "repository"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
          },
          "owner": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_.-]*[A-Za-z0-9])?$"
          },
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_.-]*[A-Za-z0-9])?$"
          }
        }
      }
    }
  }
}
